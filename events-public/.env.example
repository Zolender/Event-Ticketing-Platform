# Server-only: the browser never talks to Supabase, so nothing here is NEXT_PUBLIC_.
# The publishable key can read only the published_events view.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# This site's own address, for canonical links, previews and the sitemap.
SITE_URL=http://localhost:3000
# The organiser app's address, for the home page's sign-in link.
ORGANISER_URL=http://localhost:3001
# Shared with the database (Supabase Vault, public_site_refresh_secret); guards /api/revalidate.
REVALIDATE_SECRET=
